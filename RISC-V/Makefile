# Lyra SDK Makefile for every RISC-V question in this folder.
# Usage: make a folder (e.g. q5), put this Makefile and main.c in it, then:
#   make          build
#   make flash    flash the ARIES board (press reset if it waits)
#   make clean    remove build files

# Specify executable name
TARGET = main

# C source files
C_SOURCES = main.c

include $(VEGA_SDK_PATH)/build.mk
